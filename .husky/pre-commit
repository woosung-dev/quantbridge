# [BL-307] 소스 첫 3줄 한국어 헤더 주석 — **차단**. 신규 파일이 규칙 밖으로 새는 것을 막는 지점이다.
# ★스테이징에 대상 소스가 있을 때만 돈다(전량 스캔 1.6초지만, 문서/설정만 고치는 커밋까지 물릴 이유는 없다).
# ★감사기는 판별력 자기검사에 실패하면 rc=3 으로 죽는다 — 그때도 커밋은 막힌다(조용한 통과 금지).
if git diff --cached --name-only | grep -qE '^(backend/src/.*\.py|frontend/src/.*\.(ts|tsx))$'; then
  if ! scripts/header-audit.sh; then
    echo ""
    echo "[BL-307] 첫 3줄에 한국어 헤더 주석이 없는 소스가 있다. 위 목록을 고치고 다시 커밋해라."
    echo "         규칙 근거 = AGENTS.md:23 · 확인 = make header-audit"
    exit 1
  fi
fi

