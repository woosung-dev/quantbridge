# === Playwright MCP ad-hoc evidence (root) ===
# dogfood / smoke 스크린샷 — repo root 무시
# (codex G.2 P1 #2: docs/dev-log/screenshots/ 은 예외 — 리뷰어 재현 가능)
sprint*-day*-*.png
sprint*-day*-*.jpeg
!docs/dev-log/screenshots/**

# === AI tooling ===
# .ai/ 는 AGENTS.md 가 규범 근거로 인용하는 코딩 규칙 원본 → 버전 관리 대상.
# (2026-07-26: 무시 상태여서 AGENTS.md 참조 11건이 전부 죽어 있었다)
#
# .claude/ 정책 — 통째 무시하고 팀이 공유해야 할 것만 ! 로 뚫는다.
# 고스타 레포 90개 실측에서 ! 예외 대상 1위는 skills/(14건), settings.json 은 3건이었다.
# 지금 .claude/skills/ 에 있는 건 전부 서드파티 설치 패키지라 공유 대상이 아니다.
# 프로젝트 고유 스킬을 만들면 그때 `!.claude/skills/` 를 추가한다 (개인용은 local-* 접두사).
.claude/*
!.claude/settings.json
# 아래 셋은 위 .claude/* 로 이미 무시되지만, 작업 찌꺼기임을 명시해 둔다.
# (worktrees 무시는 조사한 90개 중 20개가 쓰는 최다 패턴)
.claude/plans/
.claude/worktrees/
.claude/sessions/
# .claude/settings.local.json (개인 override)은 위 .claude/* 규칙으로 자동 무시됨
.agents/
# .gstack/ 는 gstack skill 임시 산출물 전반 무시. experiments/ 는 실측 자산이라 예외.
.gstack/*
!.gstack/experiments/
.gstack/experiments/**/.venv/
.gstack/experiments/**/workdir/
.gstack/experiments/**/__pycache__/
.gstack/experiments/**/*.py[cod]

# === 환경 변수 ===
.env
.env.local
.env.*.local
.env.demo
!.env.example
# [BL-757] 배포용 이름 3종 — 종전에는 `git check-ignore` 실측으로 **셋 다 뚫려 있었다**.
# 하필 추적 중인 `apps/api/.env.prod.example` 이 정확히 그 작명을 유도한다.
#
# ★★**이 5줄이 하위 디렉터리까지 전부 덮는다.** 슬래시 없는 패턴은 재귀 적용이므로
#   `apps/api/.env.prod` · `apps/web/.env.production` 도 여기서 잡힌다(2026-08-16
#   `git check-ignore --no-index` 로 9경로 실측). ⇒ **`apps/*/.gitignore` 에 같은 줄을
#   복제하지 마라.** 처음에 복제했다가 되돌렸는데, 이유는 중복 자체가 아니라 대가였다:
#   `apps/web/**` 에 diff 가 생기면 `final-gates` 의 `has_fe` 가 1이 되어 FE 게이트 3종과
#   화면·vercel 신호가 강제되고, `final-gates-test.sh` 케이스 ⑩(「FE diff 0인데 신호가
#   필수인가」)이 **이 브랜치에서 상시 red** 가 된다. 시크릿 한 줄도 안 막아주면서
#   회차 비용만 올린다.
.env.prod*
.env.production*
.env.staging*
# ★부정 패턴은 **뒤에 와야** 이긴다(나중 규칙 우선). 위 `.env.prod*` 가 추적 중인
#   `apps/api/.env.prod.example` 까지 잡으므로, 이 줄이 없으면 그 템플릿이 사라진다 —
#   `.env*.example` 4종은 계속 추적돼야 한다. 그것이 문서다.
!.env*.example

# === Node / Frontend ===
node_modules/
# ★슬래시로 끝나는 패턴은 **디렉터리만** 잡는다. 워크트리 부트스트랩이 만드는
#   `node_modules -> ../../../node_modules` 는 심볼릭이라 안 걸려 `git add -A` 에 딸려 들어간다
#   (2026-08-07 실측 — 실제로 한 번 커밋됐다). 슬래시 없는 형태를 함께 둔다.
node_modules
.next/
.turbo/
dist/
build/
coverage/
*.tsbuildinfo
.pnpm-store/
# Clerk keyless mode 로컬 상태 (Next.js가 자동 생성)
apps/web/.clerk/

