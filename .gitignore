__pycache__/
*.py[cod]
*$py.class
.venv/
# 위 node_modules 와 같은 이유 — 워크트리의 `apps/api/.venv` 는 심볼릭이다.
.venv
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

