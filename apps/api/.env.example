# QuantBridge — Backend `.env.example` (uvicorn / celery worker)
#
# === 로드 주체 ===
# 이 파일을 `cp .env.example .env.local`로 복사.
# pydantic-settings SettingsConfigDict(env_file=(".env.local", ".env")) 가 자동 로드.
# 대상 명령: `cd apps/api && uv run uvicorn ...` / `uv run celery ...` / `uv run pytest` / `uv run alembic ...`
#
# === 컨테이너 실행 시 ===
# `docker compose up` 시 이 파일은 사용되지 않음. `docker-compose.yml`의 `environment:`가
# 루트 `.env`의 값을 interpolate해서 컨테이너에 주입. 즉 root `.env`와 이 파일은 공통 키를 복사 유지.
#
# === 다른 서비스 env 위치 ===
# - Docker compose:     ../../.env (root)
# - Next.js dev:        ../web/.env.local

# =====================================================
# 앱 설정
# =====================================================
APP_NAME=QuantBridge
APP_ENV=development                                                    # development | staging | production
DEBUG=true
SECRET_KEY=dev-secret-change-in-prod                                   # [필수 prod] dev placeholder OK / production 은 실값 의무 (validator 강제). 생성: openssl rand -hex 32
# BL-561 — root logger 레벨. celery worker / uvicorn 양쪽에 동일 적용 (src/common/logging_config.py).
# `extra=` 로 넘긴 필드가 ` key=value` 로 메시지 뒤에 붙는다. 오타는 기동 시 validator 가 거부.
# ★이게 SSOT 다 — docker-compose 의 `celery --loglevel=info` 는 더 이상 root 레벨을 정하지 않는다.
LOG_LEVEL=INFO                                                         # [기본값 OK] DEBUG | INFO | WARNING | ERROR | CRITICAL

# =====================================================
# 인증 — Better Auth JWT 검증 (ADR-034)
# =====================================================
# ★백엔드는 **시크릿을 하나도 쥐지 않는다.** 검증은 공개 키(JWKS)로 한다.
#   구 Clerk 은 `CLERK_SECRET_KEY` 를 API + 워커 4벌에 뿌려야 했다 — 그 표면이 통째로 없어졌다.
#
# Better Auth 서버(= FE 앱)의 공개 origin. JWT 의 iss/aud 검증 기준이다.
# ★FE 의 `BETTER_AUTH_URL` 과 **같은 값**이어야 한다. 어긋나면 전건 401 이다.
BETTER_AUTH_URL=http://localhost:3000                                  # [필수 prod]
# JWKS 취득 URL 을 직접 지정(선택). 비우면 위 값 + `/api/auth/jwks` 로 파생한다.
# ★서버 배포에서는 Cloudflare 터널을 왕복하지 않도록 컨테이너 내부 주소를 넣어라.
#   예: BETTER_AUTH_JWKS_URL=http://quantbridge-frontend:3000/api/auth/jwks
BETTER_AUTH_JWKS_URL=                                                  # [기본값 OK] 비우면 파생
# TradingView webhook 시크릿 rotation grace (인증과 무관 — 이름이 비슷할 뿐이다)
WEBHOOK_SECRET_GRACE_SECONDS=3600                                      # [기본값 OK] rotation grace 기간

# =====================================================
# Database (Sprint 3+)
# =====================================================
# docker-compose의 db 서비스가 localhost:5432에서 노출. 값은 root .env의 POSTGRES_* 와 일치해야.
DATABASE_URL=postgresql+asyncpg://quantbridge:password@localhost:5432/quantbridge  # [기본값 OK]
# ★[BL-451] pytest 는 이 변수를 **의무**로 요구한다. 없으면 `tests/_db_guard.py` 가
# `DATABASE_URL` 로 폴백하지 않고 rc=3 으로 세션을 끝낸다 — 그 폴백이 2026-07-25 에
# 로컬 개발 DB 를 전소시킨 경로다(주문 17행 · 암호화된 API 키 · 전략 6종, 키는 복구 불가).
# ★반드시 `_test` 로 끝나는 DB 를 가리켜라. 세션 픽스처가 여기에 drop_all 을 돈다.
TEST_DATABASE_URL=postgresql+asyncpg://quantbridge:password@localhost:5432/quantbridge_test  # [필수 — pytest]
# ★★이 파일을 통째로 source 하면 이 변수는 **무시된다.** `conftest.py:52` 는
# `if not os.environ.get("REDIS_LOCK_URL")` 일 때만 여기로 폴백하는데, 아래 REDIS_LOCK_URL 이
# 이미 값을 갖고 있기 때문이다. ⇒ 격리 스택(6380)에서 pytest 를 돌릴 때는
# `worktree-bootstrap.sh` 를 쓰거나(두 URL 을 함께 바꾼다) **두 변수를 같이 override** 해라.
# 하나만 바꾸면 테스트 lock Redis 가 격리되지 않는다. 슬롯별 lock DB = `3+N`.
TEST_REDIS_LOCK_URL=redis://localhost:6379/3                                             # [기본값 OK — pytest]

# =====================================================
# Redis / Celery (Sprint 4+)
# =====================================================
CELERY_BROKER_URL=redis://localhost:6379/1                             # [기본값 OK]
CELERY_RESULT_BACKEND=redis://localhost:6379/2                         # [기본값 OK]
REDIS_LOCK_URL=redis://localhost:6379/3                                # [기본값 OK] 분산 락 + rate limit (Sprint 10 A1)

# `/healthz` 가 celery worker ping 을 기다리는 초. `src/health/router.py` 가 Settings 를 거치지
# 않고 `os.environ` 에서 직접 읽는다 — 그래서 이 줄이 그 변수의 유일한 선언이다.
# 비우면 코드 기본값 12.0. 값이 작으면 워커가 살아 있어도 `/healthz` 가 503 을 낸다.
HEALTHZ_CELERY_TIMEOUT_S=                                              # [기본값 OK] 비우면 12.0

# =====================================================
# Sprint 12 Phase A — Slack alerts
# =====================================================
# Slack incoming webhook URL. 비어 있으면 silent skip (best-effort).
# 발급: Slack workspace → Apps → Incoming Webhooks → Add to Slack.
SLACK_WEBHOOK_URL=                                                     # [선택] https://hooks.slack.com/services/...
# Telegram Bot API. 비어 있으면 Telegram alert만 silent skip (best-effort).
# 발급: BotFather → token, Telegram chat ID 확인.
TELEGRAM_BOT_TOKEN=                                                    # [선택] Telegram Bot API token
TELEGRAM_CHAT_ID=                                                      # [선택] Telegram target chat ID

# =====================================================
# Sprint 6+ Trading
# =====================================================
# Fernet 마스터 키 — 거래소 API Key AES-256 암호화.
# 생성: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# root .env의 TRADING_ENCRYPTION_KEYS와 동일 값 유지 (compose worker와 로컬 uvicorn이 같은 키여야 복호화 일관).
TRADING_ENCRYPTION_KEYS=                                               # [필수 Sprint 6+]

# Dogfood 일일 리포트 HTML 출력 디렉토리 (프로젝트 루트 상대 경로).
DOGFOOD_REPORT_OUTPUT_DIR=docs/reports/dogfood                         # [기본값 OK]

# pynescript AST 디스크 캐시 (BL-832). 콜드 파스 1회는 실측상 2.7~53.4초이고 그 비용은
# 프로세스가 바뀔 때마다 다시 든다 — 이 캐시가 「소스당 영구 1회」로 만든다.
# 빈 값이면 비활성(프로세스 지역 lru_cache만 남는다).
PINE_AST_CACHE_DIR=.ast-cache                                          # [기본값 OK] apps/api 상대
# 캐시 총 용량 상한(byte). 초과 시 mtime 오래된 항목부터 소각.
PINE_AST_CACHE_MAX_BYTES=536870912                                     # [기본값 OK] 512MiB

# =====================================================
# Exchange (Sprint 5+)
# =====================================================
EXCHANGE_PROVIDER=fixture                                              # [DEPRECATED Sprint 22 BL-091] dispatch 는 ExchangeAccount.exchange + mode + Order.leverage 기반. 본 env 는 test_config.py 호환용 dead config (Sprint 23+ 제거 예정)
BYBIT_FUTURES_MAX_LEVERAGE=20                                          # [기본값 OK] Sprint 7a leverage 상한

# Bybit Demo Trading (실제 값은 .env.demo 별도 파일로 관리 — 커밋 금지)
# 발급: Bybit 계정 → API 관리 → Demo Trading 탭 → 신규 API Key (Read + Trade 권한)
BYBIT_DEMO_KEY=                                                        # [필수 Demo dogfood]
BYBIT_DEMO_SECRET=                                                     # [필수 Demo dogfood]

# Bybit Demo Trading — Phase C real_broker 전용 (nightly CI only)
# 발급: Bybit 계정 → API 관리 → Demo Trading 탭 → 신규 API Key (Read + Trade 권한)
# 운영 BYBIT_DEMO_KEY 와 분리된 별도 key (CI runner 격리 목적)
BYBIT_DEMO_API_KEY_TEST=                                               # [필수 Phase C nightly]
BYBIT_DEMO_API_SECRET_TEST=                                            # [필수 Phase C nightly]

# Bybit smoke — `scripts/bybit-smoke.sh` → `apps/api/scripts/bybit_smoke.py` 가 읽는다 ([BL-003])
# ★argv 로 넘기지 않는 이유: 같은 호스트의 아무 프로세스나 `ps` 로 평문 키를 읽는다.
# ★Bybit Demo Trading에서 발급한 키만 사용한다. mainnet 키는 제품 범위 밖이다.
BYBIT_SMOKE_API_KEY=                                                   # [필수 smoke 실행 시]
BYBIT_SMOKE_API_SECRET=                                                # [필수 smoke 실행 시]
OHLCV_PROVIDER=timescale                                               # fixture | timescale. timescale=CCXT live fetch + Hypertable 캐시. fixture 는 CI/oracle 전용.
OHLCV_FIXTURE_ROOT=apps/api/data/fixtures/ohlcv                         # [기본값 OK]
DEFAULT_EXCHANGE=bybit                                                 # [기본값 OK]

# =====================================================
# Pine Script v2 Interpreter (Sprint X1+X3)
# =====================================================
PINE_ALERT_HEURISTIC_MODE=strict                                       # strict | loose. loose 는 LuxAlgo 류 'Long break of trendline' alert 을 LONG_ENTRY 로 분류 (i2_luxalgo dogfood). strict (default) 는 break/trendline 키워드를 INFORMATION 우선.

# =====================================================
# Kill Switch (Sprint 6+)
# =====================================================
# 아래 값은 Demo 계정의 리스크 가드 기본값이다. 환경별 demo 자본에 맞춰 명시 조정한다.
KILL_SWITCH_CUMULATIVE_LOSS_PERCENT=10.0                               # [기본값 OK]
KILL_SWITCH_DAILY_LOSS_USD=500.0                                       # [기본값 OK]
KILL_SWITCH_API_ERROR_STREAK=5                                         # [기본값 OK]
KILL_SWITCH_CAPITAL_BASE_USD=10000                                     # [기본값 OK] Sprint 6은 config, 7b부터 동적 바인딩

# =====================================================
# Backtest (Sprint 4+)
# =====================================================
BACKTEST_STALE_THRESHOLD_SECONDS=1800                                  # [기본값 OK]
OPTIMIZER_STALE_THRESHOLD_SECONDS=1800                                 # [기본값 OK]
STRESS_TEST_STALE_THRESHOLD_SECONDS=1800                               # [기본값 OK]

# =====================================================
# Rate limiting (Sprint 10 Phase B)
# =====================================================
# 신뢰 가능한 reverse proxy IP/CIDR 화이트리스트 (콤마 구분).
# 비어 있으면 전달 헤더 전부 무시 + request.client.host 직접 사용 (fail-safe).
# ★[BL-754] 비워 두면 프록시 뒤에서 **전 사용자가 한 버킷**이 된다 — 한 사람이 한도를
#   태우면 전원 429. 그래서 공개 배포에서는 [필수]다.
# ★★이 배포에서 넣을 값은 **Cloudflare 공인 대역이 아니라 `127.0.0.1/32`** 다:
#   cloudflared 가 `network_mode: host` 로 돌아 uvicorn 이 보는 peer 는 루프백이다
#   (`infra/compose/docker-compose.frontend.yml`, 2026-08-16 실측).
#   실 클라이언트 IP 는 Cloudflare 가 넣는 `CF-Connecting-IP` 에서 읽는다 —
#   `X-Forwarded-For` leftmost 는 **클라이언트가 심을 수 있다**(CF 는 덮어쓰지 않고 뒤에 붙인다).
TRUSTED_PROXIES=                                                       # [기본값 OK] 로컬 dev 는 비움
# e2e rate limit 면제 신원. production/staging 에서는 설정 금지 (로컬/CI 전용).
E2E_RATE_LIMIT_EXEMPT_EMAIL=                                           # [기본값 OK]

# =====================================================
# Observability — Sprint 9 Phase D
# =====================================================
# GET /metrics endpoint 보호용 bearer token. Grafana Cloud Agent 의 bearer_token 과 동일 값.
# 생성: openssl rand -hex 32
# ★2026-08-11 fail-closed 전환 — 비어 있으면 /metrics 는 **모든 요청에 401** 이다.
# 종전엔 「비면 인증 없이 접근 가능(로컬 개발용)」이었고, 그게 dev·local·스테이징을
# 통째로 무인증 노출시키던 표면이었다. 로컬에서 /metrics 를 보려면 값을 채워라.
PROMETHEUS_BEARER_TOKEN=                                               # [필수 prod] production validator 강제 (BL-246). 비우면 dev 에서도 /metrics 는 401
# Prometheus multiprocess writer 설정. 이 두 변수는 `.env.local` 에 써도 무효다 — pydantic-settings 는 `os.environ` 에 export 하지 않고 `prometheus_client` 는 `os.environ` 을 직접 읽는다. compose `environment:` 와 Makefile 에서만 설정된다.
# 컨테이너 API 배포에서는 두 변수를 API에도 반드시 주입하고 worker와 같은 볼륨을 mount한다. 누락 시 단일 프로세스 fallback으로 떨어져 worker 지표가 보이지 않는다.
PROMETHEUS_MULTIPROC_DIR=
QB_METRICS_ROLE=

# =====================================================
# Waitlist (Sprint 11 Phase C)
# =====================================================
# Resend (Email provider, free tier 100/일). 발급: https://resend.com/ → API Keys
RESEND_API_KEY=                                                        # [필수 Beta waitlist 발송]
# ★[BL-072] Resend 는 **인증된 도메인**에서만 보낸다. 기본값의 quantbridge.app 은 이 배포의
#   도메인이 아니다(qb.woosung.dev) — 그대로 두면 발송이 403 이다.
RESEND_FROM_ADDRESS=                                                   # [필수 Beta] 예: QuantBridge <noreply@woosung.dev>
# Invite token HMAC 비밀. 최소 32바이트. 생성: openssl rand -hex 32
WAITLIST_TOKEN_SECRET=                                                 # [필수 Beta waitlist]
# Admin endpoint 화이트리스트 (콤마 구분). 비어 있으면 admin 엔드포인트 차단.
WAITLIST_ADMIN_EMAILS=                                                 # [필수 admin] ex) founder@example.com,ops@example.com
# Invite landing URL. token 이 `/{token}` 으로 append 됨.
WAITLIST_INVITE_BASE_URL=http://localhost:3000/invite                  # [기본값 OK] prod 에서는 실 도메인

# =====================================================
# LLM — Convert(Pine→Pine 정제) · Brief 해설([ADR-040]) · 전략 생성([ADR-041])
# (Anthropic 우선 + Gemini fallback)
# =====================================================
# Indicator 자동 분석 + strategy 변환용 LLM provider.
# Anthropic 호출이 transient retry 3회 모두 실패 시 Gemini 로 자동 fallback.
# 둘 중 하나는 필수. 둘 다 미설정 시 **LLM 엔드포인트 3종만** 503 이고
# 결정론 브리핑(`GET /strategies/{id}/brief`)과 백테스트는 그대로 돈다([ADR-040] 결정 4).
# ★brief 해설·전략 생성은 `tools=`/`response_schema=` 로 **스키마를 강제**한다 —
#   convert 는 그 인자가 없어 문자열을 수동 파싱한다(같은 키를 쓰지만 계약이 다르다).
# 발급: https://console.anthropic.com/ → API Keys / https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=                                                     # [미사용] 2026-08-28 결정으로 기본 순서에서 뺐다. 쓰려면 키 + LLM_PROVIDER_ORDER 에 이름 추가
ANTHROPIC_MODEL=claude-sonnet-4-6                                      # [기본값 OK] sonnet-4-6 (비용 최적) 또는 opus (고정확)
GEMINI_API_KEY=                                                        # [선택] Anthropic 최종 실패 시 자동 fallback
GEMINI_MODEL=gemini-3.7-flash                                          # [기본값 OK] 실측 대안: 3.6-flash · 3.5-flash · 3.5-flash-lite. ★2.0-flash 는 폐기(404)
OPENAI_API_KEY=                                                        # [선택] 발급: https://platform.openai.com/api-keys
OPENAI_MODEL=gpt-4.1-mini                                              # [기본값 OK] 짧은 JSON 이라 mini 가 비용 대비 합리적
# ★provider 시도 순서. 앞에서부터 시도하고 키 없는 것은 건너뛴다. 하나만 적으면 fallback 없음.
#   환경마다 가진 키가 다르므로 코드가 아니라 여기서 정한다(종전에는 코드에 박혀 있었다).
LLM_PROVIDER_ORDER=openai,gemini                                       # [기본값 OK] 앞에서부터 시도. anthropic 도 유효 값이지만 기본에서 제외

# =====================================================
# CORS
# =====================================================
FRONTEND_URL=http://localhost:3000                                     # [필수 prod] CORS — production 은 실 FE 도메인 의무 (기본 localhost 면 prod 에서 실제 FE origin 을 CORS 거부)
