      "source": "//@version=5\nindicator(\"QB color identity and NA v5\",overlay=false)\nphase=bar_index%8-1\nplot(phase,title=\"phase\")\nplot(color.new(#010305,0)==color.rgb(1,3,5) ? 1 : 0,title=\"new_rgb\")\nplot(color.new(#010305,0)==#010305 ? 1 : 0,title=\"new_hex\")\nplot(#aabbcc==#AABBCC ? 1 : 0,title=\"hex_case\")\nplot(color.red==#FF5252 ? 1 : 0,title=\"red_legacy\")\nplot(color.red==#F23645 ? 1 : 0,title=\"red_current\")\nplot(color.rgb(0.5,1.5,2.5)==color.rgb(0,1,2) ? 1 : 0,title=\"rgb_float\")\nplot(color.rgb(1,3,5,49.5)==color.rgb(1,3,5,49) ? 1 : 0,title=\"rgb_transp_float\")\nplot(color.new(#010305,49.5)==color.new(#010305,49) ? 1 : 0,title=\"new_transp_float\")\nplot(na(color(na)) ? 1 : 0,title=\"cast_na\")\ncast_color=color(na)\nplot(color.r(cast_color),title=\"cast_r\")\nplot(color.g(cast_color),title=\"cast_g\")\nplot(color.b(cast_color),title=\"cast_b\")\nplot(color.t(cast_color),title=\"cast_t\")\nhex8_color=#01030580\nplot(color.r(hex8_color),title=\"hex8_r\")\nplot(color.g(hex8_color),title=\"hex8_g\")\nplot(color.b(hex8_color),title=\"hex8_b\")\nplot(color.t(hex8_color),title=\"hex8_t\")\nvalue_na_color=color.from_gradient(float(na),0.0,4.0,#000000,#010305)\nplot(color.r(value_na_color),title=\"value_na_r\")\nplot(color.g(value_na_color),title=\"value_na_g\")\nplot(color.b(value_na_color),title=\"value_na_b\")\nplot(color.t(value_na_color),title=\"value_na_t\")\nnew_na_color=color.new(color(na),0)\nplot(color.r(new_na_color),title=\"new_na_r\")\nplot(color.g(new_na_color),title=\"new_na_g\")\nplot(color.b(new_na_color),title=\"new_na_b\")\nplot(color.t(new_na_color),title=\"new_na_t\")\nboth_na_color=color.from_gradient(phase,0.0,4.0,na,na)\nplot(color.r(both_na_color),title=\"both_na_r\")\nplot(color.g(both_na_color),title=\"both_na_g\")\nplot(color.b(both_na_color),title=\"both_na_b\")\nplot(color.t(both_na_color),title=\"both_na_t\")\ntransparent_color=color.new(#010305,100)\nplot(color.r(transparent_color),title=\"transparent_r\")\nplot(color.g(transparent_color),title=\"transparent_g\")\nplot(color.b(transparent_color),title=\"transparent_b\")\nplot(color.t(transparent_color),title=\"transparent_t\")\n"
