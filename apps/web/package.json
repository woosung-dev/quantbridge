{
  "name": "quantbridge-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check . && eslint .",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=chromium",
    "e2e:authed": "node -e \"if(process.env.NODE_ENV==='production'){console.error('e2e:authed blocked in production'); process.exit(1)}\" && playwright test --project=chromium-authed --workers=1",
    "e2e:all": "playwright test",
    "e2e:design-canon": "playwright test --project=chromium-design-canon",
    "e2e:install": "playwright install --with-deps chromium",
    "screen-evidence": "node scripts/screen-evidence.mjs",
    "screen-evidence:update": "node scripts/screen-evidence.mjs --update"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "better-auth": "^1.6.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "pg": "^8",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/eslint-plugin-query": "^5.99.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.0",
    "shadcn": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
