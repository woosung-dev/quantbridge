# QuantBridge — Frontend `.env.example` (Next.js dev/build)
#
# === 로드 주체 ===
# 이 파일을 `cp .env.example .env.local`로 복사.
# Next.js는 `.env.local` > `.env.development` > `.env`를 자동 로드.
# 대상 명령: `cd apps/web && pnpm dev` / `pnpm build`
#
# === NEXT_PUBLIC_ 프리픽스 ===
# NEXT_PUBLIC_ 접두사가 붙은 변수만 클라이언트 번들에 노출됨.
# 시크릿 값은 절대 NEXT_PUBLIC_에 넣지 말 것 (GitHub leak 위험).
#
# === 다른 서비스 env 위치 ===
# - Backend uvicorn:    ../api/.env.local
# - Docker compose:     ../../.env (root)

# =====================================================
# Better Auth (ADR-034 — 이 앱이 인증 서버 본체다)
# =====================================================
# ★전부 **서버 전용**이다. `NEXT_PUBLIC_` 접두가 없다는 뜻은 번들에 인라인되지 않는다는 것 —
#   종전 Clerk 의 publishable key 처럼 브라우저로 나가는 값이 하나도 없다.
#
# 세션 암호화·해싱 키. 32자 이상. 생성: openssl rand -base64 32
# ★미설정이면 production 에서 Better Auth 가 부팅을 거부한다. 개발 기본값에 기대지 마라.
BETTER_AUTH_SECRET=                                                        # [필수 prod]
# 이 앱의 공개 origin. JWT 의 iss/aud 와 소셜 콜백 기준이 된다.
# ★FastAPI 가 같은 값을 `BETTER_AUTH_URL` 로 갖고 있어야 한다 — 어긋나면 전건 401 이다.
BETTER_AUTH_URL=http://localhost:3000                                      # [필수 prod]
# 인증 테이블(auth_*) 전용 Postgres DSN. ★앱 DB 롤을 그대로 쓰지 마라 —
#   FE 컨테이너는 인터넷 표면이므로 `auth_*` 5테이블에만 권한이 있는 롤을 준다.
BETTER_AUTH_DATABASE_URL=postgresql://quantbridge:password@localhost:5432/quantbridge  # [필수]

# =====================================================
# Backend API URL
# =====================================================
# 로컬 개발: uvicorn localhost:8000. 프로덕션: 배포 URL.
NEXT_PUBLIC_API_URL=http://localhost:8000                              # [기본값 OK]
# 서버(SSR/RSC) 전용 FastAPI 주소 — NEXT_PUBLIC_ 이 아니라 브라우저 번들에 안 들어간다. 비우면
# NEXT_PUBLIC_API_URL 로 간다. ★현 배포(오라클)는 FE 컨테이너→호스트 uvicorn 내부 경로가 없어 비운다.
API_URL=                                                               # [optional]
NEXT_PUBLIC_WS_URL=ws://localhost:8000                                 # [기본값 OK] WebSocket (실시간 데이터)
# Sprint 60 S3 BL-268 — Webhook base URL (외부 TradingView 호출용 production endpoint)
# 미설정 시 NEXT_PUBLIC_API_URL fallback (dev 환경, 외부 호출 불가)
NEXT_PUBLIC_WEBHOOK_BASE_URL=                                          # [optional] 예: https://hooks.quantbridge.app

# =====================================================
# Sprint 13 Phase B: Test Order Dialog (dogfood-only)
# =====================================================
# /trading 페이지에서 browser-side HMAC 서명으로 webhook 직접 발송하는 dogfood 도구.
# Production 은 false 또는 미설정 — 사용자가 webhook secret 노출 위험.
NEXT_PUBLIC_ENABLE_TEST_ORDER=true                                     # [dogfood 전용]

# =====================================================
# Playwright E2E 로그인 — local-only, dev-only
# =====================================================
# `pnpm e2e:authed` 의 `global.setup.ts` 가 이 계정으로 **실제 /sign-in 폼**을 채운다.
# 계정이 없으면 setup 이 `/api/auth/sign-up/email` 로 한 번 만들고 진행한다(로컬 DB 전용).
# ★두 값은 `.env.local`(gitignored)에만 넣어라. production 에서는 절대 쓰지 않는다.
# ★★`global.setup.ts` 가 `.env.local` 을 **직접** 읽는다 — `playwright.config.ts` 에는
#   dotenv 가 없다. 종전에는 `clerkSetup()` 이 그 일을 우연히 대신하고 있었다(ADR-034).
E2E_AUTH_EMAIL=e2e@dogfood.local                                       # [e2e:authed prereq]
E2E_AUTH_PASSWORD=PASTE_PASSWORD_HERE                                  # [e2e:authed prereq]
