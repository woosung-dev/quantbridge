{
  "name": "quantbridge-root",
  "version": "0.0.0",
  "private": true,
  "description": "QuantBridge 루트 — husky pre-commit 훅 및 레포 전역 도구 전용 (apps/web·apps/api는 각자 독립)",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.6.0"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,js,jsx}": [
      "bash -c 'cd apps/web && pnpm exec eslint --fix --no-warn-ignored --'"
    ],
    "apps/api/**/*.py": [
      "bash -c 'cd apps/api && .venv/bin/ruff check --fix --exit-non-zero-on-fix \"${0#apps/api/}\" \"${@#apps/api/}\"'",
      "bash -c 'cd apps/api && .venv/bin/ruff check \"${0#apps/api/}\" \"${@#apps/api/}\"'",
      "bash -c 'cd apps/api && .venv/bin/ruff format \"${0#apps/api/}\" \"${@#apps/api/}\"'"
    ],
    "*.{json,md,yml,yaml}": [
      "bash -c 'a=(); for f in \"$@\"; do [ -L \"$f\" ] || a+=(\"$f\"); done; [ ${#a[@]} -eq 0 ] || prettier --write \"${a[@]}\"' --"
    ]
  }
}
