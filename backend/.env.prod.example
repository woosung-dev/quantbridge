# QuantBridge — Backend production secret 체크리스트 (`.env.prod.example`)
#
# === 목적 ===
# production(APP_ENV=production) 배포 시 반드시 채워야 하는 secret/env 의 SSOT 체크리스트.
# dev 용 `backend/.env.example` 와 분리 — 여기 있는 키는 placeholder 로 두면 prod 부팅이
# 실패하거나(validator) CORS/인증/암호화가 깨진다. Cloud Run 배포 시 이 목록을
# **GCP Secret Manager** 에 등록하고 `--update-secrets` 로 주입한다(컨테이너 ENV 평문 금지).
#
# === 검증 ===
# `src/core/config.py` 의 `_enforce_production_safety` validator 가 아래 [validator 강제]
# 항목을 부팅 시점에 검사 → placeholder/빈 값이면 ValueError 로 fail-fast.
#
# === 생성 명령 ===
#   SECRET_KEY / WAITLIST_TOKEN_SECRET / PROMETHEUS_BEARER_TOKEN : openssl rand -hex 32
#   TRADING_ENCRYPTION_KEYS : uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# =====================================================
# 앱 — production 모드
# =====================================================
APP_ENV=production                  # production 고정 (validator 가 debug=false 강제)
DEBUG=false

# =====================================================
# [validator 강제] — 비거나 dev default 면 부팅 실패
# =====================================================
SECRET_KEY=                         # [validator 강제] openssl rand -hex 32. 'change-me'/'dev-secret-change-in-prod' 금지
CLERK_SECRET_KEY=                   # [validator 강제] Clerk Dashboard → API Keys → Secret keys (pk_live/sk_live prod 키)
WAITLIST_TOKEN_SECRET=             # [validator 강제] invite token HMAC. openssl rand -hex 32 (최소 32 bytes)
PROMETHEUS_BEARER_TOKEN=           # [validator 강제] /metrics 보호 (BL-246). openssl rand -hex 32. Grafana Agent bearer_token 과 동일

# =====================================================
# [필수] 암호화 / 인증 — 검증되거나 기능 차단
# =====================================================
TRADING_ENCRYPTION_KEYS=           # [필수] Fernet 키(validator 가 형식 검증). 최초 1회 생성 후 불변 — 변경 시 기존 암호화 API Key 복호화 불가
CLERK_WEBHOOK_SECRET=              # [필수] Clerk webhook 서명 검증 (whsec_...)

# =====================================================
# [필수 infra] — Cloud SQL / Memorystore (Secret Manager 또는 VPC 내부 주소)
# =====================================================
DATABASE_URL=                       # [필수] postgresql+asyncpg://USER:PASS@HOST:5432/DB (TimescaleDB hosting 결정 — G1 참조)
REDIS_URL=                          # [필수] redis://HOST:6379/0 (Memorystore)
CELERY_BROKER_URL=                  # [필수] redis://HOST:6379/1
CELERY_RESULT_BACKEND=              # [필수] redis://HOST:6379/2
REDIS_LOCK_URL=                     # [필수] redis://HOST:6379/3 (분산 락 + rate limit)

# =====================================================
# [필수 prod] — CORS / 도메인 (기본 localhost 면 prod 에서 실제 FE 거부)
# =====================================================
FRONTEND_URL=                       # [필수 prod] https://<실 FE 도메인> (CORS allow-origin)
WAITLIST_INVITE_BASE_URL=          # [필수 prod] https://<실 FE 도메인>/invite

# =====================================================
# [필수 Beta] — waitlist 발송 / 관리
# =====================================================
RESEND_API_KEY=                     # [필수 Beta] Resend → API Keys (도메인 인증 후)
WAITLIST_ADMIN_EMAILS=             # [필수 Beta] admin 화이트리스트 (콤마 구분). 비면 admin endpoint 차단

# =====================================================
# [권장 prod] — 운영
# =====================================================
SLACK_WEBHOOK_URL=                  # [권장] https://hooks.slack.com/services/... (kill-switch/alert 발송)
TRUSTED_PROXIES=                    # [권장] Cloud Run/LB 의 IP/CIDR (X-Forwarded-For 신뢰 범위)
