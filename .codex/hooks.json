{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/tools/scripts/hooks/codex-block-dangerous.sh\"",
            "timeout": 10,
            "statusMessage": "위험 명령 검사"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/tools/scripts/hooks/codex-verify-gate.sh\"",
            "timeout": 300,
            "statusMessage": "변경 영역 lint 게이트"
          }
        ]
      }
    ]
  }
}
