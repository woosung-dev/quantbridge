# QuantBridge — Root `.env.example` (docker compose 전용)
#
# === 로드 주체 ===
# 이 파일을 `cp .env.example .env`로 복사. docker compose는 `./env`를 자동 로드.
# `docker-compose.yml`의 `${VAR}` interpolation이 여기를 참조.
# backend/frontend 각자 loader는 별도 `.env.example` (해당 디렉토리) 사용.
#
# === 다른 서비스 env 위치 ===
# - Backend uvicorn/celery (로컬 실행):   backend/.env.example → backend/.env.local
# - Frontend Next.js dev:                 frontend/.env.example → frontend/.env.local
#
# === 범례 ===
# [필수 Sprint N]   : 해당 스프린트부터 실값 필요
# [기본값 OK]       : 로컬 개발은 이 값 그대로

# =====================================================
# PostgreSQL (docker-compose `db` 서비스)
# =====================================================
POSTGRES_USER=quantbridge                                              # [기본값 OK]
POSTGRES_PASSWORD=password                                             # [기본값 OK] 로컬 전용
POSTGRES_DB=quantbridge                                                # [기본값 OK]

# =====================================================
# Sprint 6+ Trading (docker-compose `backend-worker` interpolation)
# =====================================================
# Fernet 마스터 키 — 거래소 API Key AES-256 암호화용.
# 최초 1회만 생성, 변경 시 기존 암호화된 API Key 복호화 불가.
# 생성: cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: 콤마 구분으로 여러 키 허용 (new_key,old_key). 첫 키 encrypt, 나머지 decrypt grace.
TRADING_ENCRYPTION_KEYS=                                               # [필수 Sprint 6+]

# =====================================================
# Clerk 인증 (docker-compose `backend-worker` interpolation)
# =====================================================
# Compose로 워커를 띄울 때 backend/.env.local이 아닌 이 값을 사용.
# 로컬 uvicorn만 띄우면 backend/.env.local만 채워도 OK.
CLERK_SECRET_KEY=sk_test_PASTE_YOUR_SECRET_KEY_HERE                    # [필수 Sprint 3+]
CLERK_WEBHOOK_SECRET=whsec_placeholder_sprint7_real_value              # [필수 Sprint 7 배포]

# =====================================================
# 로그 (BL-561 — docker-compose 4 celery 서비스 interpolation)
# =====================================================
# root logger 레벨의 SSOT. worker / ws-stream / optimizer-heavy / beat 4 서비스에 주입된다.
# ★compose command 의 `celery --loglevel=info` 는 root 레벨을 정하지 않는다 — 이 값이 정한다.
# 로컬 uvicorn 은 backend/.env.local 의 LOG_LEVEL 을 읽는다 (backend/.env.example 참조).
LOG_LEVEL=INFO                                                         # [기본값 OK] DEBUG | INFO | WARNING | ERROR | CRITICAL

# =====================================================
# Exchange / Backtest (docker-compose `backend-worker` interpolation)
# =====================================================
EXCHANGE_PROVIDER=fixture                                              # [DEPRECATED Sprint 22 BL-091] dispatch 는 ExchangeAccount.exchange + mode + Order.leverage 기반. 본 env 는 test_config.py 호환용 dead config (Sprint 23+ 제거 예정)
OHLCV_PROVIDER=timescale                                               # fixture | timescale (Sprint 5 M3+). timescale=CCXT live fetch + Hypertable 캐시. fixture 는 CI/oracle 전용.
DEFAULT_EXCHANGE=bybit                                                 # [기본값 OK]
BACKTEST_STALE_THRESHOLD_SECONDS=1800                                  # [기본값 OK] worker stale 재클레임 threshold
PINE_ALERT_HEURISTIC_MODE=strict                                       # strict | loose. loose 는 LuxAlgo 류 'Long break of trendline' alert 을 LONG_ENTRY 로 분류 (i2_luxalgo dogfood). strict (default) 는 break/trendline 키워드를 INFORMATION 우선.

# =====================================================
# Sprint 10 — Redis 분산 락 + rate-limit (docker-compose `backend-worker` / `backend-beat` interpolation)
# =====================================================
# Celery broker(DB 1) / result(DB 2) 와 격리된 별도 논리 DB(3) 사용.
# broker burst·eviction 으로 lock 유실 방지 (codex plan-stage 보강).
# 운영에서 ElastiCache 등 외부 Redis 로 override 하려면 이 값을 변경.
REDIS_LOCK_URL=redis://redis:6379/3                                    # [기본값 OK] Sprint 10 A1

# =====================================================
# Sprint 12 Phase A — Slack alerts (Kill Switch / daily_loss)
# =====================================================
# Slack incoming webhook URL. 비어 있으면 alert silent skip (best-effort).
# 발급: Slack workspace → Apps → Incoming Webhooks → Add to Slack → channel 선택.
# 형식: https://hooks.slack.com/services/T.../B.../...
SLACK_WEBHOOK_URL=                                                     # [선택] Beta 운영 시 권장

# =====================================================
# Wave 0 W2 — Telegram alerts (critical 이벤트 미러)
# =====================================================
# Telegram Bot API token + chat id. 둘 중 하나라도 비어 있으면 alert silent skip.
# 발급: Telegram 에서 @BotFather → /newbot → token 수령. chat id 는 봇과 대화 후
# https://api.telegram.org/bot<TOKEN>/getUpdates 의 chat.id 확인.
# token 형식: <digits>:<alphanumeric> (예: 123456789:AAH...).
TELEGRAM_BOT_TOKEN=                                                    # [선택] Beta 운영 시 권장
TELEGRAM_CHAT_ID=                                                      # [선택] 숫자 id 또는 @channelusername

# =====================================================
# Rate limiting (Sprint 10 Phase B, docker-compose `backend-worker` interpolation)
# =====================================================
TRUSTED_PROXIES=                                                       # [기본값 OK] 로컬 dev 는 비움

# =====================================================
# Bybit Demo — Sprint 10 Phase C (nightly CI 전용)
# =====================================================
BYBIT_DEMO_API_KEY_TEST=                                               # [필수 Phase C nightly]
BYBIT_DEMO_API_SECRET_TEST=                                            # [필수 Phase C nightly]

# =====================================================
# 소크 게이트 운영 스크립트 오버라이드 (scripts/soak-*.sh 전용 — 앱 Settings 아님)
# =====================================================
QB_DB_CONTAINER=                                                       # [기본값 OK] quantbridge-db — 게이트가 psql 을 대는 컨테이너
QB_WORKER_CONTAINER=                                                   # [기본값 OK] quantbridge-worker — 분류기가 로그를 읽는 컨테이너
QB_REDIS_CONTAINER=                                                    # [기본값 OK] quantbridge-redis — C5⑸ AOF 판독 검사 대상 (스크래치 검증 시 교체)
QB_METRICS_DIR=                                                        # [기본값 OK] backend/.metrics — 게이트 C5⑷ 의 **기본** 취득 경로 (prometheus multiproc dir 직독)
QB_METRICS_URL=                                                        # [기본값 OK] 비우면 위 dir 직독. **값을 넣으면** 그 URL 을 HTTP 로 긁는다 (원격 데몬 + ssh 터널용)
QB_SRC_ROOT=                                                           # [기본값 OK] 소크 스냅샷 원본 경로
QB_SOAK_OVERRIDE=                                                      # [평시 비움] 1 = pin 이중 가드 우회 — 알면서 쓸 때만
